# .env.example
# ─────────────────────────────────────────────────────
# Copy this file to .env and fill in your values
# NEVER commit .env to git — it is gitignored
# ─────────────────────────────────────────────────────

# Postgres settings (used by the Postgres Docker container)
POSTGRES_USER=taskuser
POSTGRES_PASSWORD=taskpassword
POSTGRES_DB=taskdb

# Full connection URL (used by the FastAPI app to connect)
DATABASE_URL=postgresql://taskuser:taskpassword@db:5432/taskdb